[Unit]
Description=READY Linux primary programming console
After=local-fs.target

[Service]
Type=simple
User=ready
Group=ready
Environment=XDG_DATA_HOME=/var/lib/readylinux
ExecStart=/usr/bin/readylinux --workspace /var/lib/readylinux/programs
Restart=on-failure
RestartSec=1
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StateDirectory=readylinux
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/readylinux

[Install]
WantedBy=multi-user.target
