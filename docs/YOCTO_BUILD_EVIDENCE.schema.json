{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readylinux.example/schemas/yocto-build-evidence.schema.json",
  "title": "READY Linux Yocto Build Evidence",
  "description": "Auditable evidence for one READY Linux Yocto build and target-specific boot run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "identity", "environment", "image", "boot", "verdict"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utc_date", "host_os", "host_arch", "poky_commit", "readylinux_commit", "bitbake_version", "distro", "machine"],
      "properties": {
        "utc_date": {"type": "string", "format": "date-time"},
        "host_os": {"type": "string", "minLength": 1},
        "host_arch": {"type": "string", "minLength": 1},
        "poky_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "layer_commits": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}},
        "readylinux_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "bitbake_version": {"type": "string", "minLength": 1},
        "distro": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "bsp_revision": {"type": "string"},
        "tclibc": {"type": "string"},
        "init_system": {"type": "string"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_dir", "bblayers_conf_sha256", "local_conf_sha256", "parse_exit_code", "parse_log"],
      "properties": {
        "build_dir": {"type": "string", "minLength": 1},
        "bblayers_conf_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "local_conf_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "parse_exit_code": {"type": "integer"},
        "parse_log": {"type": "string", "minLength": 1}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_command", "source_cache_state", "exit_code", "build_log"],
      "properties": {
        "build_command": {"type": "string", "minLength": 1},
        "source_cache_state": {"enum": ["cached", "fetched", "unknown", "not-built"]},
        "exit_code": {"type": ["integer", "null"]},
        "build_log": {"type": ["string", "null"]},
        "artifact_path": {"type": ["string", "null"]},
        "artifact_format": {"type": ["string", "null"]},
        "artifact_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "qemu_version", "command", "console_log"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not-run"]},
        "qemu_version": {"type": ["string", "null"]},
        "command": {"type": ["string", "null"]},
        "console_log": {"type": ["string", "null"]},
        "ready_console": {"enum": ["passed", "failed", "not-run"]},
        "unprivileged_service": {"enum": ["passed", "failed", "not-run"]},
        "persistent_state": {"enum": ["passed", "failed", "not-run"]},
        "getty_mask": {"enum": ["passed", "failed", "not-run"]},
        "basic_smoke": {"enum": ["passed", "failed", "not-run"]},
        "offline_smoke": {"enum": ["passed", "failed", "not-run"]}
      }
    },
    "deviations": {"type": "array", "items": {"type": "string"}},
    "verdict": {"enum": ["reproducible-and-booted", "built-not-booted", "failed", "not-verified"]}
  }
}
